# CLIP MASTER — copy this file to `.env` and fill in what you need.
# Everything is optional: without any key the app still works (transcription, scene detection,
# tracking and export are local); only the LLM "AI crew" features need Groq or Ollama.
# Never put a real secret in this file.

# --- LLM (AI crew, subtitle translation) -----------------------------------
# Mode: auto (default) = Groq if GROQ_API_KEY is set, otherwise LOCAL OLLAMA ("no-key mode").
#       groq | ollama | none  -> force a mode ("none" = no LLM, heuristics only).
# Transcription is always local: it never needs a key.
LLM_PROVIDER=auto
# Groq (cloud, free tier available): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_SMALL=qwen/qwen3.8-27b
GROQ_MODEL_BIG=openai/gpt-oss-120b
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
# Local, free, no account: install https://ollama.com then `ollama pull qwen2.5:7b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Legacy alias used only if OLLAMA_MODEL is empty
# MODEL_SMALL=qwen2.5:7b
LLM_TIMEOUT=120

# --- Server ------------------------------------------------------------------
CLIP_MASTER_HOST=127.0.0.1
CLIP_MASTER_PORT=7866
# Extra Host headers to allow, comma-separated (in addition to localhost / CLIP_MASTER_HOST)
# CLIP_MASTER_ALLOWED_HOSTS=
# Access token. REQUIRED (16+ chars) when CLIP_MASTER_HOST is not a loopback address (e.g. 0.0.0.0): the server
# refuses to start without it. Optional on 127.0.0.1. Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Browser: open http://<ip>:7866/?token=<token> once. Scripts: "Authorization: Bearer <token>" or "X-Clip-Master-Token: <token>".
# CLIP_MASTER_TOKEN=
# Extra browser origins allowed for POST/PATCH/DELETE (reverse proxy), comma-separated
# CLIP_MASTER_ALLOWED_ORIGINS=
# Source URLs pointing at private / loopback / link-local addresses are refused (SSRF guard). 1 = allow them.
# CLIP_MASTER_ALLOW_PRIVATE_URLS=0
# Default language of API error messages (fr or en; the UI sends its own) and log level
# CLIP_MASTER_LANG=en
# CLIP_MASTER_LOG_LEVEL=INFO
# Upload size limit in MB (local MP4 upload)
CLIP_MASTER_MAX_UPLOAD_MB=2048
# Video download timeout in seconds
CLIP_MASTER_DOWNLOAD_TIMEOUT=1800

# --- Folders (default: next to the code) -------------------------------------
# CLIP_MASTER_DATA_DIR=
# CLIP_MASTER_PROJECTS_DIR=
# CLIP_MASTER_OUTPUTS_DIR=
# CLIP_MASTER_MODELS_DIR=
# CLIP_MASTER_BIN_DIR=

# --- External binaries (leave empty to use PATH) -------------------------------
FFMPEG_PATH=
# Optional, only for Twitch VOD + chat download: https://github.com/lay295/TwitchDownloader
TWITCHDOWNLOADER_CLI=

# --- Disk cleanup / free-space guard -----------------------------------------
# Auto-purge project workdirs, intermediate files and exports older than this many hours.
# 0 disables automatic cleanup (the UI button and `clip-master clean` still work).
CLIP_MASTER_CACHE_TTL_HOURS=48
# Refuse new jobs when free space on the data volume is below this many MB. 0 disables the guard.
CLIP_MASTER_MIN_FREE_MB=1024
# Background sweep interval in seconds. 0 disables the periodic sweeper (a pass still runs at startup if the TTL is > 0).
CLIP_MASTER_CACHE_SWEEP_SECONDS=1800

# --- Compute device (transcription + subject tracking) -----------------------
# auto (default) = CUDA when a GPU is visible via PyTorch or ctranslate2, otherwise CPU int8.
# cpu | cuda to force a choice (cuda falls back to CPU if no device is found).
# DirectML is not auto-enabled; use a CUDA GPU or CPU.
CLIP_MASTER_DEVICE=auto
